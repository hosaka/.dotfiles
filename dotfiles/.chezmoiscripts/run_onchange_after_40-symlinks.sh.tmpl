{{- if (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian" )) -}}
#!/usr/bin/env bash

{{ template "shared_script.bash.tmpl" . }}
# bat is installed as batcat
if ! has bat && has batcat; then
  mkdir --parents "$HOME/.local/bin"
  ln -s $(which batcat) "$HOME/.local/bin/bat"
  info "symlink batcat to bat"
fi

# fd is installed as fdfind
if ! has fd && has fdfind; then
  mkdir --parents "$HOME/.local/bin"
  ln -s $(which fdfind) "$HOME/.local/bin/fd"
  info "symlink fdfind to fd"
fi
{{- end }}
