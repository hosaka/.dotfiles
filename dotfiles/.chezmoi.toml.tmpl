{{- $desktop := promptBoolOnce . "desktop" "Is this a desktop computer? (y/N)" -}}
{{- $personal := promptBoolOnce . "personal" "Is this a personal computer? (y/N)" -}}
{{- $development := promptBoolOnce . "development" "Do you do development on this computer? (y/N)" -}}
{{- $nvidia := promptBoolOnce . "nvidia" "Does this computer have an NVIDIA GPU? (y/N)" -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

encryption = "age"
[age]
  # no identity file, age-yubikey decrypts with whichever YubiKey from recipients.txt is plugged in
  command        = {{ joinPath .chezmoi.workingTree "age-yubikey" | quote }}
  recipientsFile = {{ joinPath .chezmoi.workingTree "recipients.txt" | quote }}

[data]
  desktop     = {{ $desktop }}
  personal    = {{ $personal }}
  development = {{ $development }}
  nvidia      = {{ $nvidia }}
  osid        = {{ $osid | quote }}
