.config/chezmoi

{{- if eq .chezmoi.os "linux" }}
# turnstiled rewrites turnstile-ready/run at every login, its conf and the
# dbus service are managed (turnstile only ships dbus.run/check as examples)
.config/service/turnstile-ready/run
.config/service/**/supervise
.config/service-env/
.psensor/
# flatpak app data
.var/
{{- end }}

{{- if not .desktop }}
# graphical apps and the user services that turnstile runs, add new GUI configs here
.config/alacritty
.config/fontconfig
.config/foot
.config/fuzzel
.config/gtk-3.0
.config/gtk-4.0
.config/kanshi
.config/miru
.config/mozilla
.config/mpv
.config/neovide
.config/niri
.config/noctalia
.config/nwg-look
.config/pipewire
.config/qt6ct
.config/service
.config/wezterm
.config/xdg-desktop-portal
.config/xdg-desktop-portal-termfilechooser
.config/xsettingsd
.face
{{- end }}

{{- if not .personal }}
.config/aerc
.config/halloy
{{- end }}

{{- if not .development }}
.config/lazygit
.config/mise
.wakatime.cfg
{{- end }}

{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell/
{{- end }}

{{- if env "CHEZMOI_NO_SECRETS" }}
# templates that read secrets from rbw, skipped when building images
# (vast-mklive), run `rbw unlock && chezmoi apply` after installing
.config/aerc/accounts.conf
.wakatime.cfg
{{- end }}

