.nv/
.opencode/
.rustup/
.wakatime/

.mise.toml
.gtkrc-2.0

.config/chezmoi

{{- if eq .chezmoi.os "linux" }}
# turnstiled rewrites turnstile-ready/run at every login, its conf and the
# dbus service are managed (turnstile only ships dbus.run/check as examples)
.config/service/turnstile-ready/run
.config/service/**/supervise
.config/service-env/
.psensor/
# flatpak app data
.var/
{{- end }}

{{- if not .personal }}
.config/aerc
.config/halloy
{{- end }}

{{- if not .development }}
.config/lazygit
.config/mise
.wakatime.cfg
{{- end }}

{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell/
{{- end }}

{{- if env "CHEZMOI_NO_SECRETS" }}
# templates that read secrets from rbw, skipped when building images
# (vast-mklive), run `rbw unlock && chezmoi apply` after installing
.config/aerc/accounts.conf
.wakatime.cfg
{{- end }}

