{{- /* encrypted dotfiles of the profiles that are currently on, the missing files 
       are skipped until a YubiKey from recipients.txt is plugged in and readable */ -}}

{{- $encrypted := list }}
{{- if .personal }}
  {{ $encrypted = append $encrypted ".config/aerc/accounts.conf" }}
{{ end }}

{{- if .development }}
  {{ $encrypted = append $encrypted ".wakatime.cfg" }}
{{ end }}

{{- $missing := list }}
{{- range $encrypted }}
  {{ if not (stat (joinPath $.chezmoi.destDir .)) }}
    {{ $missing = append $missing . }}
  {{ end }}
{{ end }}

{{- if and $missing (ne (output (joinPath .chezmoi.workingTree "age-yubikey") "--check" | trim) "ok") }}
  {{ join "\n" $missing }}
{{- end }}

