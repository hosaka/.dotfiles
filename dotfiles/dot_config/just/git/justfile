alias s := sign
alias p := prune
alias r := resign

[doc('list recipes (default)')]
[no-cd]
@help:
    just --list=git --no-aliases

[arg('val', pattern='true|false', help='true enables commit signing in this repository, false disables it')]
[doc('enable gpg signing (alias `s`)')]
[no-cd]
[no-exit-message]
sign val='true':
    git config commit.gpgsign {{ val }}

[arg('val', pattern='true|false', help='true enables removing deleted remote branches on fetch, false disables it')]
[doc('enable pruning on fetch from origin (alias `p`)')]
[no-cd]
[no-exit-message]
prune val='true':
    git config remote.origin.prune {{ val }}

[arg('ref', help='Commit to start after, every later commit is signed again')]
[doc('gpg sign the last commits again (alias `r`)')]
[no-cd]
[no-exit-message]
resign ref='HEAD~1':
    git rebase --keep-empty --exec "git commit --amend --no-edit --gpg-sign" {{ ref }}
    git log --abbrev-commit --date=relative --date-order --pretty=format:"%C(auto,yellow)%h %C(auto,blue)%>(12,trunc)%ad %C(auto,white italic)%G? %C(reset)%C(auto,green)%<(12,trunc)%aN %C(reset)%s" {{ ref }}..HEAD
