import '../common.just'

cwd := quote(invocation_directory())

alias m := mount

[doc('list recipes (default)')]
[no-cd]
@help:
    just --list=usb --no-aliases

[doc('mount usb device with current uid and gid')]
[no-cd]
mount device path="/mnt/usb":
    {{ sudo }} mount -o uid=$(id -u),gid=$(id -g) {{ device }} {{ path }}
