import '../common.just'

alias m := mount

[doc('list recipes (default)')]
[no-cd]
@help:
    just --list=usb --no-aliases

[arg('path', help='Mount point')]
[arg('device', pattern='/dev/.+', help='Partition to mount, e.g. /dev/sdb1')]
[doc('mount a FAT, exFAT or NTFS partition owned by the current user (alias `m`)')]
[no-cd]
mount device path='/mnt/usb':
    {{ sudo }} mount -o uid=$(id -u),gid=$(id -g) {{ device }} {{ path }}
