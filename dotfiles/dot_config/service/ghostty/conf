# Make GTK apps talk to IBus over D-Bus instead of the Wayland
# input-method protocol. Works around ibus <1.5.34 making Ghostty drop
# non-text keys after a focus change. See:
# https://github.com/ghostty-org/ghostty/discussions/9250
# https://github.com/ibus/ibus/issues/2819
# This can be removed once the distro shipped ibus is >1.5.34
export GTK_IM_MODULE=ibus

# runsv starts services in their service directory, and Ghostty's default
# `working-directory=inherit` would open the first window there
OPTS="--working-directory=home"
