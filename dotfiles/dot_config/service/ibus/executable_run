#!/bin/sh

[ -r ./conf ] && . ./conf

# ibus-ui-gtk3 doesn't exit when it can't open the display, so runsv would
# never restart it, don't start it before niri is ready instead
sv start ../niri-ready || exit 1

exec chpst -e "$TURNSTILE_ENV_DIR" /usr/libexec/ibus-ui-gtk3 \
  --enable-wayland-im --exec-daemon --daemon-args "--panel disable $OPTS" 2>&1
